# Global
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:8080
MAX_FILE_SIZE_BYTES=10485760

# MongoDB
MONGODB_URI=mongodb://mongo:27017/verified_document_vault

# Blockchain
CHAIN_ID=31337
RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=replace_with_local_dev_key
# Public Hardhat development key only. Never use outside the local chain.
LOCAL_HARDHAT_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYMENT_FILE=/deployments/registry.json
WORKER_API_KEY=replace_with_a_random_secret_at_least_32_characters

# Storage
IPFS_PROVIDER=local
IPFS_PINATA_API_KEY=
IPFS_PINATA_SECRET_API_KEY=

# Auth
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
DOCUMENT_ENCRYPTION_KEY=replace_with_64_hex_characters
DEMO_ISSUER_PASSWORD=choose_a_password_with_at_least_12_characters

# ML service
ML_SERVICE_URL=http://localhost:8001

# Frontend dev proxy
VITE_API_PROXY=http://localhost:3000
